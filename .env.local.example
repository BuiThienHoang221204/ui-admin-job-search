# Sao chép thành .env.local rồi chỉnh nếu cần.

# Trình duyệt gọi /api trên chính origin của app admin, rewrites() chuyển sang BACKEND_URL.
# Giữ đường dẫn tương đối: URL tuyệt đối sang máy khác làm cookie httpOnly bị vứt, mọi lời gọi nhận 401.
NEXT_PUBLIC_API_URL=/api

# Backend thật, chỉ tiến trình máy chủ của Next đọc (không có tiền tố NEXT_PUBLIC_).
BACKEND_URL=http://localhost:4000

# Địa chỉ app người dùng, cho nút "Về Careelot" trên thanh bên.
NEXT_PUBLIC_USER_APP_URL=http://localhost:3000
